    "\n",
    "percent_train = 0.6\n",
    "data_size = len(data.data)   # assuming data is already normalized\n",
    "\n",
    "# arange index number from 0 to data_size\n",
    "idx = np.arange(data_size)\n",
    "\n",
    "# random shuffle idx (1 line)\n",
    "np.random.seed(7)\n",
    "np.random.shuffle(idx)\n",
    "\n",
    "# calculate number of training set\n",
    "m_train = int(percent_train * data_size)\n",
    "\n",
    "# split train_idx and test_idx\n",
    "train_idx = idx[0:m_train]\n",
    "test_idx = idx[m_train:]\n",
    "\n",
    "# split to X_train and X_test\n",
    "X_train = data.data[train_idx]\n",
    "X_test = data.data[test_idx]\n",
    "\n",
    "# split to y_train y_test and y_test_indices\n",
    "# (assuming you have labels y with same length as data)\n",
    "y_train = y[train_idx]\n",
    "y_test = y[test_idx]\n",
    "y_test_indices = test_idx\n",
    "\n",
    "print(\"Train X:\", X_train)\n",
    "print(\"Test X:\", X_test)\n",
    "print(\"Train y:\", y_train)\n",
    "print(\"Test y:\", y_test)\n",
    "print(\"Test indices:\", y_test_indices)"
   ]
